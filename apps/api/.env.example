DATABASE_URL="mysql://usuario:senha@localhost:3306/unirv_sports"

# Obrigatório, mínimo 32 caracteres. Gere com:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

PORT=3001

# Pré-lançamento: "false" bloqueia o login e toda a área logada (só cadastro).
# Sem a variável: liberado em dev, bloqueado com NODE_ENV=production.
LOGIN_ENABLED=true

# URL(s) do front-end autorizadas no CORS, separadas por vírgula. Obrigatório em produção.
# CORS_ORIGIN="https://unirv-sports-web.onrender.com"
